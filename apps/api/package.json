{
  "name": "@truchabrew/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:fastify --external:@fastify/static --external:drizzle-orm --external:better-sqlite3",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seedCli.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@truchabrew/calculations": "*",
    "@truchabrew/shared-types": "*",
    "better-sqlite3": "*",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.28.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}
